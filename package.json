{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run generate-routes && npm run build:nuxt",
    "build:nuxt": "nuxi build",
    "generate": "npm run generate-routes && npm run generate:static",
    "generate:static": "nuxi generate",
    "generate-routes": "node scripts/generate-event-routes.js",
    "dev": "nuxi dev",
    "dev:routes": "npm run generate-routes && npm run dev",
    "preview": "nuxi preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run generate-routes && npm run build && ./scripts/deploy.sh",
    "deploy:fast": "npm run generate-routes && ./scripts/deploy.sh",
    "seo:check": "npm run generate-routes && npm run build",
    "routes:verify": "node scripts/generate-event-routes.js --dry-run"
  },
  "dependencies": {
    "@nuxt/image": "^1.11.0",
    "@nuxt/scripts": "^0.11.10",
    "@nuxt/ui": "^4.0.0-alpha.0",
    "@nuxtjs/sitemap": "^7.4.7",
    "@tailwindcss/vite": "^4.1.11",
    "@types/qrcode": "^1.5.5",
    "@unhead/vue": "^2.0.14",
    "@vueuse/motion": "^3.0.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-vue-next": "^0.539.0",
    "nuxt": "^4.0.3",
    "nuxt-auth-utils": "^0.5.23",
    "preline": "^3.2.3",
    "qr-code-styling": "^1.9.2",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-recaptcha-v3": "^2.0.1",
    "vue-router": "^4.5.1",
    "vue3-google-signin": "^2.1.1"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.2",
    "nuxt-pdfmake": "^0.0.47",
    "nuxt-qrcode": "^0.4.6"
  }
}
